# ===== Database =====
# This project ships an embedded PostgreSQL (see `npm run db:start`).
# Point DATABASE_URL at your own PostgreSQL instance if you prefer.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/travel_agent?schema=public"

# ===== Auth.js =====
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST=true

# ===== AI (any OpenAI-compatible endpoint) =====
# Default below is DeepSeek, which supports function calling on deepseek-chat.
# Get a key at https://platform.deepseek.com
AI_API_KEY="your-api-key-here"
AI_BASE_URL="https://api.deepseek.com/v1"
AI_MODEL="deepseek-chat"

# Other verified-compatible setups:
#   AI_BASE_URL="https://api.openai.com/v1"          AI_MODEL="gpt-4o-mini"
#   AI_BASE_URL="https://apihub.agnes-ai.com/v1"     AI_MODEL="agnes-2.5-flash"
