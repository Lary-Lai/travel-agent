# ===== Database =====
# This project ships an embedded PostgreSQL (see `npm run db:start`).
# Point DATABASE_URL at your own PostgreSQL instance if you prefer.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/travel_agent?schema=public"

# ===== Auth.js =====
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST=true

# ===== AI (OpenAI-compatible endpoint) =====
# Agnes 2.5 Flash -> https://apihub.agnes-ai.com/v1
AI_API_KEY="your-api-key-here"
AI_BASE_URL="https://apihub.agnes-ai.com/v1"
AI_MODEL="agnes-2.5-flash"
