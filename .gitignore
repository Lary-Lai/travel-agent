# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local embedded PostgreSQL cluster (data directory + logs)
/data/
!data/.gitkeep

# generated Prisma client (recreate with `npm run db:generate`)
/lib/generated/

# generated PDF test fixture (recreate with: node scripts/make-test-pdf.mjs)
/scripts/sample-travel-plan.pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.git-commit-msg.txt
commit-msg-refund.txt
