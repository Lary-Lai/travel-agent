// AI Travel Agent — Prisma schema
// Datasource: real PostgreSQL (embedded cluster, see scripts/db.mjs)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  // Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and in
  // lib/db.ts via the pg driver adapter (for the client). It is no longer
  // allowed inside schema files.
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum PropertyType {
  APARTMENT
  HOUSE
  HOTEL
  VILLA
  CABIN
  LOFT
  GUESTHOUSE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/// Payment channels offered at checkout. No real gateway is integrated — the
/// demo marks a booking as paid through `payBooking`.
enum PaymentMethod {
  WECHAT
  ALIPAY
  CARD
}

/// Refund lifecycle. A refund is created when a PAID booking is cancelled and
/// starts life as PROCESSING, mirroring how real channels settle asynchronously.
enum RefundStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum RefundReason {
  USER_CANCELLED
  HOST_CANCELLED
}

// ---------------------------------------------------------------- models

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  createdAt DateTime @default(now())

  hostedListings Listing[]     @relation("HostListings")
  wishlists      Wishlist[]
  bookings       Booking[]

  @@index([email])
}

model Listing {
  id            String       @id @default(cuid())
  title         String
  description   String
  location      String
  city          String
  country       String
  latitude      Float
  longitude     Float
  pricePerNight Int
  propertyType  PropertyType
  rating        Float        @default(0)
  reviewCount   Int          @default(0)
  maxGuests     Int
  bedrooms      Int
  beds          Int
  bathrooms     Int
  hostId        String
  createdAt     DateTime     @default(now())

  host          User             @relation("HostListings", fields: [hostId], references: [id], onDelete: Cascade)
  images        ListingImage[]
  amenities     ListingAmenity[]
  wishlistItems WishlistItem[]
  bookings      Booking[]

  @@index([city])
  @@index([propertyType])
  @@index([pricePerNight])
  @@index([hostId])
  @@index([city, pricePerNight])
  @@index([city, propertyType, pricePerNight])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  url       String
  position  Int     @default(0)
  /// Which part of the property this angle shows (客厅 / 主卧 / 厨房 ...).
  /// Drives the gallery captions so guests can tell the angles apart.
  caption   String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

/// Canonical amenity dictionary, shared across listings (many-to-many).
model Amenity {
  id       String  @id @default(cuid())
  name     String  @unique
  icon     String?
  category String?
  /// Plain-language explanation, shown when a guest taps the amenity.
  description String?

  listings ListingAmenity[]

  @@index([category])
}

/// Explicit join table so the m-n relation carries its own identity + FKs.
model ListingAmenity {
  listingId String
  amenityId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
  @@index([amenityId])
}

model Wishlist {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  /// One user cannot own two wishlists with the same name.
  @@unique([userId, name])
  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  listingId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  listing  Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// A listing can only appear once per wishlist.
  @@unique([wishlistId, listingId])
  @@index([wishlistId])
  @@index([listingId])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  listingId   String
  checkIn     DateTime      @db.Date
  checkOut    DateTime      @db.Date
  guests      Int
  /// Derived from checkIn/checkOut, stored so the order stays auditable.
  nights      Int
  roomPrice   Int
  cleaningFee Int
  serviceFee  Int
  totalPrice  Int
  /// New bookings start PENDING and become CONFIRMED once checkout is paid.
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  // ---- simulated payment (no real gateway) ----
  paymentMethod  PaymentMethod?
  paidAt         DateTime?
  /// Simulated transaction reference, shown on the confirmation screen.
  paymentTradeNo String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([userId])
  @@index([listingId])
  @@index([userId, status])
  @@index([listingId, checkIn, checkOut])
}

/// Refund record for a cancelled booking.
///
/// A separate table (rather than fields on Booking) so a refund has its own
/// lifecycle, its own amount — the cancellation policy may refund only part of
/// what was paid — and an auditable trail.
model Refund {
  id        String @id @default(cuid())
  bookingId String
  /// Amount actually refunded, in CNY. May be less than the booking total.
  amount    Int
  status    RefundStatus @default(PROCESSING)
  reason    RefundReason @default(USER_CANCELLED)
  /// Which cancellation tier applied when the refund was calculated.
  tier      String
  /// Refunds always go back to the original payment channel.
  method    PaymentMethod
  /// Simulated channel refund reference.
  tradeNo   String?
  /// Human-readable policy explanation shown to the user.
  note      String?

  requestedAt DateTime  @default(now())
  completedAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}
