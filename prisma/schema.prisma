// AI Travel Agent — Prisma schema
// Datasource: real PostgreSQL (embedded cluster, see scripts/db.mjs)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  // Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and in
  // lib/db.ts via the pg driver adapter (for the client). It is no longer
  // allowed inside schema files.
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum PropertyType {
  APARTMENT
  HOUSE
  HOTEL
  VILLA
  CABIN
  LOFT
  GUESTHOUSE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/// Payment channels offered at checkout. No real gateway is integrated — the
/// demo marks a booking as paid through `payBooking`.
enum PaymentMethod {
  WECHAT
  ALIPAY
  CARD
}

/// Refund lifecycle. A refund is created when a PAID booking is cancelled and
/// starts life as PROCESSING, mirroring how real channels settle asynchronously.
enum RefundStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum RefundReason {
  USER_CANCELLED
  HOST_CANCELLED
}

/// Who may open a user's profile page.
///
/// A single enum rather than a set of booleans because the modes are mutually
/// exclusive and "public + friends-only" is not a state anyone means.
enum ProfileVisibility {
  /// Anyone, including a signed-out visitor.
  PUBLIC
  /// Accepted friends only.
  FRIENDS
  /// Only the users on the allow-list, plus friends.
  SELECTED
  /// Only the owner.
  PRIVATE
}

/// One row per (owner, viewer) exception to the visibility mode.
///
/// DENY always beats ALLOW: an explicit block is the only way to keep someone out
/// of a PUBLIC profile, and "I blocked them but they can still see me because
/// they are on the allow-list" would be a bug nobody could reason about.
enum ProfileAccessKind {
  ALLOW
  DENY
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// A friendship, stored as ONE row per pair with the direction recorded.
///
/// Not two mirrored rows: a mutual pair would need both rows kept in sync on
/// every accept/remove, and any half-failed write would leave a user who is
/// "friends" in one direction only.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// A per-viewer exception to a profile's visibility mode (see ProfileAccessKind).
model ProfileAccess {
  id        String            @id @default(cuid())
  ownerId   String
  viewerId  String
  kind      ProfileAccessKind
  createdAt DateTime          @default(now())

  owner  User @relation("ProfileAccessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  viewer User @relation("ProfileAccessViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  /// One verdict per pair — setting a second one replaces the first.
  @@unique([ownerId, viewerId])
  @@index([ownerId, kind])
}

// ---------------------------------------------------------------- models

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  createdAt DateTime @default(now())

  // ---------------------------------------------------------- personalisation
  // All optional: a fresh account renders fine with none of these set.
  /// Key into lib/profile-options.ts COVER_PRESETS (a local CSS gradient).
  coverPreset       String?
  /// Custom banner image URL; wins over coverPreset when set.
  coverImage        String?
  /// Free-form self-description chips, e.g. 摄影爱好者 / 咖啡因驱动.
  tags              String[] @default([])
  /// 心仪地点 — places the user wants to go.
  dreamDestinations String[] @default([])
  /// 生活爱好
  hobbies           String[] @default([])
  /// 已旅行地点 — the "display case" of places already visited.
  visitedPlaces     String[] @default([])

  // ------------------------------------------------------------- social
  /// Who may open this profile at `/u/[id]`. Defaults to PUBLIC so the feature
  /// is discoverable rather than silently locking everyone out of a new account.
  profileVisibility ProfileVisibility @default(PUBLIC)

  accessGranted     ProfileAccess[] @relation("ProfileAccessViewer")
  accessOwned       ProfileAccess[] @relation("ProfileAccessOwner")
  friendRequestsSent Friendship[]   @relation("FriendRequestsSent")
  friendRequestsReceived Friendship[] @relation("FriendRequestsReceived")
  posts             Post[]          @relation("UserPosts")
  replies           Reply[]         @relation("UserReplies")

  hostedListings Listing[]     @relation("HostListings")
  wishlists      Wishlist[]
  bookings       Booking[]
  reviews        Review[]
  searchEvents   SearchEvent[]

  // ------------------------------------------------------- notifications
  notifications        Notification[] @relation("NotificationRecipient")
  actedNotifications   Notification[] @relation("NotificationActor")
  /// Types the user has switched off. Storing the *muted* ones (rather than the
  /// enabled ones) means a new notification type is on by default for everyone,
  /// which is what you want when adding a feature: silence would make it invisible.
  mutedNotificationTypes NotificationType[] @default([])

  @@index([email])
  @@index([profileVisibility])
}

/// Why a notification exists.
///
/// The type is stored, not the sentence: the copy is rendered from this value plus
/// the actor and target in the reader's current language. A stored string would
/// freeze whichever language the event happened in, and this app has six.
enum NotificationType {
  /// Someone asked to be your friend.
  FRIEND_REQUEST
  /// Your request was accepted.
  FRIEND_ACCEPTED
  /// Someone replied to a post you wrote.
  POST_REPLY
  /// A booking was confirmed (payment succeeded).
  BOOKING_CONFIRMED
  /// A booking was cancelled, including by the payment deadline.
  BOOKING_CANCELLED
}

model Notification {
  id        String           @id @default(cuid())
  recipient User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  type      NotificationType

  /// Who caused it. Nullable because the actor may be gone (cascade deletes the
  /// notification in that case) or because the event has no actor, e.g. an
  /// automatic cancellation by the payment deadline.
  actor     User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?

  /// Where clicking it should go, resolved when the notification is created so the
  /// reader never has to reconstruct it (and so it survives the target being
  /// deleted later — the link simply 404s instead of breaking the list).
  href      String

  /// Free-form extras for the copy: a post title, a city, an amount.
  meta      Json?

  /// Null means unread. A timestamp rather than a boolean, so "read at" is
  /// available if it is ever needed and there is no second field to keep in sync.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

model Listing {
  id            String       @id @default(cuid())
  title         String
  description   String
  location      String
  city          String
  country       String
  latitude      Float
  longitude     Float
  pricePerNight Int
  propertyType  PropertyType
  rating        Float        @default(0)
  reviewCount   Int          @default(0)
  maxGuests     Int
  bedrooms      Int
  beds          Int
  bathrooms     Int
  hostId        String
  createdAt     DateTime     @default(now())

  /// Stable identity for seeded rows (e.g. "tokyo-apartment-3").
  ///
  /// This is what lets `prisma db seed` be re-run safely: listings are upserted
  /// by this key instead of being deleted and recreated, so their ids survive
  /// and real users' wishlists and bookings are never cascade-deleted. Null for
  /// any listing created outside the seed.
  seedKey String? @unique

  // ------------------------------------------------------------- house rules
  // Shown in the "入住须知" panel on the booking widget.
  checkInTime  String   @default("15:00")
  checkOutTime String   @default("11:00")
  /// Free-form rules (禁止吸烟 / 不允许携带宠物 ...).
  houseRules   String[] @default([])
  /// Practical notes shown under the rules (停车、门禁、周边 ...).
  houseNotes   String[] @default([])

  /// Per-locale title / address, keyed by locale code (`{"en": "...", "ja": "..."}`).
  ///
  /// The Chinese `title` / `location` above stay the authored values the API and
  /// the Agent read. These carry the localised renderings used by the UI,
  /// generated by the seed from localised neighbourhood names plus title
  /// templates (`lib/i18n/listing-text/*`). JSON rather than twelve columns
  /// because the locale set is a moving target and nothing queries these fields.
  titleI18n    Json?
  locationI18n Json?

  host          User             @relation("HostListings", fields: [hostId], references: [id], onDelete: Cascade)
  images        ListingImage[]
  amenities     ListingAmenity[]
  wishlistItems WishlistItem[]
  bookings      Booking[]
  reviews       Review[]

  @@index([city])
  @@index([propertyType])
  @@index([pricePerNight])
  @@index([hostId])
  @@index([city, pricePerNight])
  @@index([city, propertyType, pricePerNight])
}

/// A guest review.
///
/// One row per (listing, user): a guest edits their own review rather than
/// stacking duplicates, which keeps the average meaningful and makes "my review"
/// a single lookup. Keyed by user id, so a review is still there on the next
/// login — that is the whole point of storing it server-side.
model Review {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  /// 1-5.
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([listingId, createdAt])
  @@index([userId])
}

/// A search the user actually ran, used to personalise recommendations.
///
/// Only recorded for signed-in users: an anonymous session has no identity to
/// personalise, and storing strangers' queries would be collection without
/// purpose. The destination is stored as the canonical city name where it
/// resolves, so "东京" and "Tokyo" aggregate together.
model SearchEvent {
  id           String        @id @default(cuid())
  userId       String
  /// Raw text the user typed.
  query        String
  /// Canonical city name when the query resolved to one, else null.
  city         String?
  guests       Int?
  priceMin     Int?
  priceMax     Int?
  propertyType PropertyType?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, city])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  url       String
  position  Int     @default(0)
  /// Which part of the property this angle shows (客厅 / 主卧 / 厨房 ...).
  /// Drives the gallery captions so guests can tell the angles apart.
  caption   String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

/// Canonical amenity dictionary, shared across listings (many-to-many).
model Amenity {
  id          String  @id @default(cuid())
  name        String  @unique
  icon        String?
  category    String?
  /// Plain-language explanation, shown when a guest taps the amenity.
  description String?

  listings ListingAmenity[]

  @@index([category])
}

/// Explicit join table so the m-n relation carries its own identity + FKs.
model ListingAmenity {
  listingId String
  amenityId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
  @@index([amenityId])
}

model Wishlist {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  /// One user cannot own two wishlists with the same name.
  @@unique([userId, name])
  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  listingId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  listing  Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// A listing can only appear once per wishlist.
  @@unique([wishlistId, listingId])
  @@index([wishlistId])
  @@index([listingId])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  listingId   String
  checkIn     DateTime      @db.Date
  checkOut    DateTime      @db.Date
  guests      Int
  /// Derived from checkIn/checkOut, stored so the order stays auditable.
  nights      Int
  roomPrice   Int
  cleaningFee Int
  serviceFee  Int
  totalPrice  Int
  /// New bookings start PENDING and become CONFIRMED once checkout is paid.
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  // ---- simulated payment (no real gateway) ----
  paymentMethod  PaymentMethod?
  paidAt         DateTime?
  /// Simulated transaction reference, shown on the confirmation screen.
  paymentTradeNo String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  refunds Refund[]

  /// Hidden from the user's list, but NOT deleted.
  ///
  /// A booking is a financial record: `Refund` rows reference it with
  /// `onDelete: Cascade`, so deleting it would also delete the refund history.
  /// Archiving keeps the audit trail while removing the row from `/trips`.
  archivedAt DateTime?

  /// Deadline for paying a PENDING hold. Past it the booking is auto-cancelled
  /// and its dates are released, so a hold can never block a listing forever.
  ///
  /// `timestamptz` rather than the default `timestamp`: this value is compared
  /// against `now()` from SQL as well as through Prisma, and a naive column makes
  /// those two disagree by the session's UTC offset (Prisma writes UTC-naive,
  /// `now()` converts to local). Every other datetime here is only ever read back
  /// through Prisma, so the default is harmless for them.
  paymentDueAt DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([listingId])
  @@index([userId, status])
  @@index([listingId, checkIn, checkOut])
}

/// A discussion board (板块) — 滑雪旅行 / 海滨度假 / 城市探索 …
///
/// Boards are rows rather than an enum so a new board is a seed change, not a
/// migration plus a redeploy of the UI that switches on the enum.
model Board {
  id       String @id @default(cuid())
  /// Stable identity for the seed, like `Listing.seedKey`.
  slug     String @unique
  /// Authored Chinese name / blurb.
  name        String
  description String
  /// Per-locale name and description, keyed by locale code. Same reasoning as
  /// `Listing.titleI18n`: the Chinese values stay the authored source of truth
  /// (the API and the Agent read them) while the UI renders the localised text.
  nameI18n        Json?
  descriptionI18n Json?
  /// Lucide icon name, chosen in the seed.
  icon     String?
  /// Emoji shown in the board header, e.g. 🎿.
  emoji    String?
  position Int    @default(0)

  posts Post[]

  @@index([position])
}

/// A forum post. Free-form (title + body), optionally tied to a city so a post
/// can be found from the place it is about.
model Post {
  id       String  @id @default(cuid())
  boardId  String
  authorId String
  title    String
  body     String
  /// Canonical English city name when the post names one, else null.
  city     String?
  /// Optional cover image (a bundled listing photo, or an uploaded one).
  image    String?
  /// Pinned posts sort first within their board.
  pinned   Boolean @default(false)
  /// Denormalised so board lists do not need a join per row to show the count.
  replyCount Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author  User    @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  replies Reply[]

  @@index([boardId, pinned, createdAt])
  @@index([authorId])
  @@index([city])
}

model Reply {
  id       String @id @default(cuid())
  postId   String
  authorId String
  body     String

  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation("UserReplies", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

/// Refund record for a cancelled booking.
///
/// A separate table (rather than fields on Booking) so a refund has its own
/// lifecycle, its own amount — the cancellation policy may refund only part of
/// what was paid — and an auditable trail.
model Refund {
  id        String        @id @default(cuid())
  bookingId String
  /// Amount actually refunded, in CNY. May be less than the booking total.
  amount    Int
  status    RefundStatus  @default(PROCESSING)
  reason    RefundReason  @default(USER_CANCELLED)
  /// Which cancellation tier applied when the refund was calculated.
  tier      String
  /// Refunds always go back to the original payment channel.
  method    PaymentMethod
  /// Simulated channel refund reference.
  tradeNo   String?
  /// Human-readable policy explanation shown to the user.
  note      String?

  requestedAt DateTime  @default(now())
  completedAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}
